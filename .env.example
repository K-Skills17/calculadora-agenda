# Anthropic AI (for schedule analysis report generation)
ANTHROPIC_API_KEY=sk-ant-...

# LK Chatbot (preferred WhatsApp delivery method)
LK_CHATBOT_URL=https://lk-chatbot-production.up.railway.app
LK_CHATBOT_API_KEY=your-chatbot-api-key
LK_CHATBOT_TENANT_ID=your-tenant-uuid

# Evolution API (fallback WhatsApp delivery)
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_INSTANCE=your-instance-name
EVOLUTION_API_KEY=your-evolution-api-key

# Google Sheets (lead storage via Apps Script web app URL)
GOOGLE_SHEET_URL=https://script.google.com/macros/s/your-script-id/exec

# Facebook Conversions API
PIXEL_ID=your-pixel-id
CAPI_ACCESS_TOKEN=your-capi-access-token
